<?xml version="1.0"?>
<!--
  aidin_gripper_simple.demo.urdf
  ─────────────────────────────────────────────────────────────
  *** 데모/시각 확인 전용 — 실측값 아님 ***
  aidin_gripper_simple.urdf 의 CAPS 플레이스홀더에 임시 숫자를 채운 사본.
  view_urdf.py 로 열림/닫힘 애니메이션을 눈으로 보기 위한 목적일 뿐이며,
  실제 제어/충돌검사/질량계산에는 절대 쓰지 마세요.

  질량/관성/충돌박스/TCP 값은 이미 검증을 통과한 aidin_gripper.urdf(fixed
  버전)의 실측값을 그대로 재사용했습니다 — 같은 실물 그리퍼이므로 그 값은
  참값입니다. 유일하게 새로 지어낸 값은 아래 두 가지뿐입니다.

    FINGER_Y0(닫힘 위치, 0.010m 가정) + STROKE_HALF(0.030m 가정)
    = 완전 개방 시 0.010+0.030=0.040m
    → aidin_gripper.urdf 의 핑거 개방 Y오프셋(0.0400m)과 정확히 일치하도록
      역산한 숫자입니다. 실측 스트로크를 알게 되면 이 두 값만 바꾸면 됩니다.

  MAX_FORCE_N / MAX_SPEED_MPS 는 애니메이션에 영향 없는 관절 한계치라
  아무 값이나 넣었습니다(모터 스펙 아님).
-->
<robot name="aidin_gripper">

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://aidin_gripper_description/meshes/visual/gripper_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.0400" rpy="0 0 0"/>
      <geometry>
        <box size="0.0700 0.0900 0.0800"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0380" rpy="0 0 0"/>
      <mass value="0.5500"/>
      <inertia ixx="4.20e-4" ixy="0.0"     ixz="0.0"
                             iyy="3.80e-4" iyz="0.0"
                                           izz="2.60e-4"/>
    </inertial>
  </link>

  <joint name="gripper_finger_1_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child  link="gripper_finger_1"/>
    <!-- DEMO: 닫힘 위치 0.010m (실측값으로 교체 필요) -->
    <origin xyz="0 0.0100 0.0800" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- DEMO: 편측 스트로크 0.030m → 완전개방 Y=0.040m (fixed 버전과 일치) -->
    <limit lower="0.0" upper="0.0300" effort="50.0" velocity="0.05"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="gripper_finger_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://aidin_gripper_description/meshes/visual/gripper_finger.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.78 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.0050 0.0250" rpy="0 0 0"/>
      <geometry>
        <box size="0.0250 0.0120 0.0500"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0040 0.0230" rpy="0 0 0"/>
      <mass value="0.0450"/>
      <inertia ixx="1.20e-5" ixy="0" ixz="0"
                             iyy="1.30e-5" iyz="0"
                                           izz="3.10e-6"/>
    </inertial>
  </link>

  <joint name="gripper_finger_2_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child  link="gripper_finger_2"/>
    <origin xyz="0 -0.0100 0.0800" rpy="0 0 3.14159265"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.0300" effort="50.0" velocity="0.05"/>
    <mimic joint="gripper_finger_1_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="gripper_finger_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://aidin_gripper_description/meshes/visual/gripper_finger.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0.0050 0.0250" rpy="0 0 0"/>
      <geometry>
        <box size="0.0250 0.0120 0.0500"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0040 0.0230" rpy="0 0 0"/>
      <mass value="0.0450"/>
      <inertia ixx="1.20e-5" ixy="0" ixz="0"
                             iyy="1.30e-5" iyz="0"
                                           izz="3.10e-6"/>
    </inertial>
  </link>

  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base"/>
    <child  link="gripper_tcp"/>
    <origin xyz="0 0 0.1350" rpy="0 0 0"/>
  </joint>

</robot>
