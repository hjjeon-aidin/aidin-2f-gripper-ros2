<?xml version="1.0"?>
<!--
═══════════════════════════════════════════════════════════════════════════
  aidin_gripper.urdf   —   RB-Y1 그리퍼와 동일 구조

  구조:  ee_right (베이스)
           ├─ ee_finger_r1   [fixed]
           └─ ee_finger_r2   [fixed]

  · 링키지(오프셋 슬라이더-크랭크) 링크 없음  → base에 전부 흡수
  · 핑거 조인트 fixed → kinematic chain에 그리퍼 자유도 없음
  · 그리퍼 개폐는 URDF 밖에서(별도 제어 채널) 처리
  · 핑거는 "완전 개방" 자세로 고정 → 충돌검사가 보수적으로 안전측

  단위: 길이 m / 질량 kg / 관성 kg·m²  (SW는 g·mm² → ÷1e9)

  ★n  = 반드시 본인 값으로 바꿔야 하는 곳 (아래 표 참조)
═══════════════════════════════════════════════════════════════════════════

  ┌─ 수정 항목 요약 ───────────────────────────────────────────────────┐
  │ ★1  robot name                                                    │
  │ ★2  메시 경로 (패키지명 / 파일명)                                 │
  │ ★3  메시 스케일  (SW STL은 mm → 0.001)                            │
  │ ★4  베이스 질량       ← SW 질량특성                               │
  │ ★5  베이스 무게중심   ← SW 질량특성 (CS_base 기준)                │
  │ ★6  베이스 관성텐서   ← SW 질량특성 ÷ 1e9                         │
  │ ★7  베이스 충돌 박스 (중심 / 크기)                                │
  │ ★8  핑거 Y 오프셋 = 개구폭 ÷ 2  (최대 개방 기준)                  │
  │ ★9  핑거 Z 오프셋 = 플랜지면 → 핑거 기준면 거리                   │
  │ ★10 핑거 질량 / 무게중심 / 관성텐서                               │
  │ ★11 핑거 충돌 박스 (중심 / 크기)                                  │
  │ ★12 TCP 위치 (플랜지면 → 파지점 Z)                                │
  │ ★13 색상 (선택)                                                   │
  └───────────────────────────────────────────────────────────────────┘
-->

<robot name="aidin_gripper">   <!-- ★1 -->

  <!-- ═══════════════ 재질 정의 (★13) ═══════════════ -->
  <material name="aidin_body">
    <color rgba="0.24 0.25 0.28 1.0"/>
  </material>
  <material name="aidin_finger">
    <color rgba="0.78 0.79 0.82 1.0"/>
  </material>


  <!-- ═══════════════════════════════════════════════════════════════
       BASE : ee_right
       원점 = ISO 9409-1-50-4-M6 플랜지 장착면 중심
       +Z   = 접근(approach) 방향,  ±Y = 핑거 개폐 방향
       ═══════════════════════════════════════════════════════════════ -->
  <link name="ee_right">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- ★2 ★3 -->
        <mesh filename="package://aidin_gripper_description/meshes/visual/gripper_base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aidin_body"/>
    </visual>

    <!-- 충돌은 메시 재사용 금지. 프리미티브로 감싸는 것이 훨씬 안정적 -->
    <collision>
      <origin xyz="0 0 0.0400" rpy="0 0 0"/>          <!-- ★7 박스 중심 -->
      <geometry>
        <box size="0.0700 0.0900 0.0800"/>            <!-- ★7 X Y Z 크기 -->
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.0000 0.0000 0.0380" rpy="0 0 0"/>  <!-- ★5 무게중심 -->
      <mass value="0.5500"/>                            <!-- ★4 질량 -->
      <!-- ★6  SW 질량특성의 Lxx…Lzz 를 1e9로 나눈 값 -->
      <inertia ixx="4.20e-4" ixy="0.0"     ixz="0.0"
                             iyy="3.80e-4" iyz="0.0"
                                           izz="2.60e-4"/>
    </inertial>
  </link>


  <!-- ═══════════════════════════════════════════════════════════════
       FINGER 1  (+Y 쪽)
       ═══════════════════════════════════════════════════════════════ -->
  <joint name="ee_finger_r1_joint" type="fixed">
    <parent link="ee_right"/>
    <child  link="ee_finger_r1"/>
    <!-- ★8 Y = 개구폭/2   ★9 Z = 플랜지면 → 핑거 기준면 -->
    <origin xyz="0 0.0400 0.0800" rpy="0 0 0"/>
  </joint>

  <link name="ee_finger_r1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- ★2 ★3 : 좌우 동일 형상이면 한 파일 재사용 -->
        <mesh filename="package://aidin_gripper_description/meshes/visual/gripper_finger.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aidin_finger"/>
    </visual>

    <collision>
      <origin xyz="0 0.0050 0.0250" rpy="0 0 0"/>     <!-- ★11 박스 중심 -->
      <geometry>
        <box size="0.0250 0.0120 0.0500"/>            <!-- ★11 X Y Z 크기 -->
      </geometry>
    </collision>

    <inertial>                                         <!-- ★10 -->
      <origin xyz="0 0.0040 0.0230" rpy="0 0 0"/>
      <mass value="0.0450"/>
      <inertia ixx="1.20e-5" ixy="0.0"     ixz="0.0"
                             iyy="1.30e-5" iyz="0.0"
                                           izz="3.10e-6"/>
    </inertial>
  </link>


  <!-- ═══════════════════════════════════════════════════════════════
       FINGER 2  (-Y 쪽)
       rpy Z=180° 로 뒤집어 동일 STL 재사용
       ═══════════════════════════════════════════════════════════════ -->
  <joint name="ee_finger_r2_joint" type="fixed">
    <parent link="ee_right"/>
    <child  link="ee_finger_r2"/>
    <!-- ★8 ★9 : finger_r1 과 Y 부호만 반대 -->
    <origin xyz="0 -0.0400 0.0800" rpy="0 0 3.14159265"/>
  </joint>

  <link name="ee_finger_r2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://aidin_gripper_description/meshes/visual/gripper_finger.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aidin_finger"/>
    </visual>

    <collision>
      <origin xyz="0 0.0050 0.0250" rpy="0 0 0"/>     <!-- ★11 -->
      <geometry>
        <box size="0.0250 0.0120 0.0500"/>
      </geometry>
    </collision>

    <inertial>                                         <!-- ★10 -->
      <origin xyz="0 0.0040 0.0230" rpy="0 0 0"/>
      <mass value="0.0450"/>
      <inertia ixx="1.20e-5" ixy="0.0"     ixz="0.0"
                             iyy="1.30e-5" iyz="0.0"
                                           izz="3.10e-6"/>
    </inertial>
  </link>


  <!-- ═══════════════════════════════════════════════════════════════
       TCP : 파지점. IK 타겟 프레임 (질량 없음)
       ═══════════════════════════════════════════════════════════════ -->
  <link name="ee_right_tcp"/>
  <joint name="ee_right_tcp_joint" type="fixed">
    <parent link="ee_right"/>
    <child  link="ee_right_tcp"/>
    <origin xyz="0 0 0.1350" rpy="0 0 0"/>            <!-- ★12 -->
  </joint>

</robot>


<!--
═══════════════════════════════════════════════════════════════════════════
 [A] RB-Y1 팔에 붙이기 — 상위 URDF/xacro 에 아래 조인트 추가
     <joint name="right_arm_to_gripper" type="fixed">
       <parent link="link_right_arm_6"/>
       <child  link="ee_right"/>
       <origin xyz="0 0 0" rpy="0 0 0"/>
     </joint>

 [B] 왼손용이 필요하면 이 파일을 복사해
     ee_right → ee_left,  _r1 → _l1,  _r2 → _l2  로 치환

 [C] 나중에 개폐 자유도를 살리려면
     ee_finger_r1_joint : type="fixed" → "prismatic"
       <axis xyz="0 1 0"/>
       <limit lower="-STROKE" upper="0" effort="..." velocity="..."/>
     ee_finger_r2_joint : 동일 + <mimic joint="ee_finger_r1_joint" multiplier="1.0"/>
     (origin 은 최대 개방 위치이므로 lower 가 음수 = 닫히는 방향)
═══════════════════════════════════════════════════════════════════════════
-->
