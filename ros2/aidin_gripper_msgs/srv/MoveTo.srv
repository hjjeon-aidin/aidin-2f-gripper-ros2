# Move the gripper to an absolute position.
# Request maps directly to firmware action registers rPR / rSP / rFR.

uint8 position    # 0 = fully open .. 255 = fully closed
uint8 speed 128   # 0..255 (default = mid)
uint8 force 128   # 0..255 (current limit; default = mid)
bool  blocking false
float32 timeout_sec 5.0
---
bool   success
string message
uint8  final_position
uint8  final_object_state   # see GripperState.OBJECT_*
